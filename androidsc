def generate_postscan_bugreport(player="sin_nombre"):
    """Genera manualmente un BugReport ADB y conserva datos de cadena de custodia."""
    global PENDING_BUGREPORT_PATH

    status = {
        "available": False,
        "generated": False,
        "result": "NO_EJECUTADO",
        "path": "",
        "sha256": "",
        "size_mb": 0,
        "serial": "",
        "generated_at": "",
        "zip_valid": False,
    }
    PENDING_BUGREPORT_PATH = None

    if not adb_available():
        status["result"] = "ADB_NO_INSTALADO"
        return status

    devices = get_adb_connected_devices()
    if not devices:
        status["result"] = "ADB_NO_CONECTADO"
        return status

    ensure_dirs()
    serial = safe_text(devices[0].get("serial"))
    status["serial"] = serial

    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    nick = safe_filename(player) or "sin_nombre"
    bugreport_path = os.path.join(
        DOWNLOAD_REPORT_DIR,
        f"BUGREPORT_{nick}_{stamp}.zip",
    )

    print(f"{BRIGHT_RED}[*]{RESET} Generando BugReport Android...")
    print(f"{DARK_GRAY}Destino: {bugreport_path}{RESET}")

    command = ["adb"]
    if serial:
        command += ["-s", serial]
    command += ["bugreport", bugreport_path]

    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=600,
        )
        output = safe_text(proc.stdout)
        if output:
            print(output[-1600:])

        # En algunos dispositivos ADB termina antes de que el archivo sea visible
        # en almacenamiento compartido. Damos unos segundos para sincronizarlo.
        for _ in range(12):
            if os.path.isfile(bugreport_path) and os.path.getsize(bugreport_path) > 0:
                break
            time.sleep(1)

        if proc.returncode != 0:
            status["result"] = f"ADB_ERROR_{proc.returncode}"
            return status

        # Respaldo: algunos builds cambian ligeramente el nombre final del ZIP.
        if not os.path.isfile(bugreport_path):
            try:
                prefix = f"BUGREPORT_{nick}_{stamp}"
                candidates = [
                    os.path.join(DOWNLOAD_REPORT_DIR, name)
                    for name in os.listdir(DOWNLOAD_REPORT_DIR)
                    if name.startswith(prefix) and name.lower().endswith(".zip")
                ]
                candidates = [p for p in candidates if os.path.isfile(p)]
                if candidates:
                    bugreport_path = max(candidates, key=os.path.getmtime)
            except Exception:
                pass

        if not os.path.isfile(bugreport_path):
            status["result"] = "ZIP_NO_ENCONTRADO"
            return status

        size_bytes = os.path.getsize(bugreport_path)
        if size_bytes <= 0:
            status["result"] = "ZIP_VACIO"
            return status

        zip_valid = zipfile.is_zipfile(bugreport_path)
        status["zip_valid"] = bool(zip_valid)
        if not zip_valid:
            status["result"] = "ARCHIVO_NO_ES_ZIP"
            return status

        digest = sha256_file(bugreport_path, max_mb=2048) or ""
        status.update({
            "available": True,
            "generated": True,
            "result": "COMPLETADO",
            "path": bugreport_path,
            "sha256": digest,
            "size_mb": round(size_bytes / (1024 * 1024), 2),
            "generated_at": datetime.now().isoformat(),
            "zip_valid": True,
        })
        PENDING_BUGREPORT_PATH = bugreport_path

        print(f"{GREEN}[OK] BugReport generado correctamente.{RESET}")
        print(f"{WHITE}SHA-256:{RESET} {digest or 'no disponible'}")
        print(f"{WHITE}Tamaño:{RESET} {status['size_mb']} MB")
        return status

    except subprocess.TimeoutExpired:
        status["result"] = "TIMEOUT"
        print(f"{SCARLET}[!] La generación del BugReport excedió el límite configurado.{RESET}")
        return status
    except Exception as exc:
        status["result"] = f"ERROR: {exc}"
        print(f"{SCARLET}[!] No se pudo generar el BugReport: {exc}{RESET}")
        return status


