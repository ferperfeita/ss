            "category": "accesos_especiales", "indicator": "suspicious_app_with_special_access",
            "value": suspicious_access[:25],
            "reasons": ["Una aplicación sensible conserva accesibilidad, superposición o permiso para instalar paquetes."],
            "source_group": "special_access"
        })
    if suspicious_removed:
        points = 10
        findings.append({
            "type": "package_history", "risk": risk_from_points(points), "risk_points": points,
            "confidence": "MEDIA", "evidence_level": "paquete_desinstalado_registrado",
            "category": "historial_paquetes", "indicator": "suspicious_uninstalled_package_record",
            "value": suspicious_removed[:30],
            "reasons": ["Package Manager conserva registros de paquetes sensibles que ya no aparecen instalados."],
            "source_group": "package_history"
        })
    suspicious_usage = [line for line in status.get("usage_timeline_samples", []) if contains_any(line.lower(), terms)]
    if suspicious_usage:
