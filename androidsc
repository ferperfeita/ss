def get_package_details(package):
    if package in PACKAGE_DETAILS_CACHE:
        return PACKAGE_DETAILS_CACHE[package]

    output = run_command(["dumpsys", "package", package], timeout=8)
    details = {
        "first_install_time": None,
        "last_update_time": None,
        "version_name": None,
        "installer": None,
        "code_path": None,
        "uid": None,
    }
    for line in output.splitlines():
        clean = line.strip()
        if clean.startswith("firstInstallTime="):
            details["first_install_time"] = clean.replace("firstInstallTime=", "")
        elif clean.startswith("lastUpdateTime="):
            details["last_update_time"] = clean.replace("lastUpdateTime=", "")
        elif clean.startswith("versionName="):
            details["version_name"] = clean.replace("versionName=", "")
        elif clean.startswith("installerPackageName="):
            details["installer"] = clean.replace("installerPackageName=", "")
        elif clean.startswith("codePath="):
            details["code_path"] = clean.replace("codePath=", "")
        elif clean.startswith("userId="):
            details["uid"] = clean.replace("userId=", "")

    PACKAGE_DETAILS_CACHE[package] = details
    return details


