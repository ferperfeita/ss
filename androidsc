        "live_process_findings": sum(1 for x in actionable_findings if x.get("category") == "procesos_delta"),
        "live_port_findings": sum(1 for x in actionable_findings if x.get("category") == "puertos_delta"),
        "current_port_findings": sum(1 for x in actionable_findings if x.get("category") == "puertos_sospechosos"),
        "ff_route_findings": sum(1 for x in actionable_findings if x.get("category") == "archivos_free_fire"),
        "apk_integrity_findings": sum(1 for x in actionable_findings if x.get("category") == "integridad_apk_free_fire"),
        "special_access_findings": sum(1 for x in actionable_findings if x.get("category") == "accesos_especiales"),
