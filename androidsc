def _parse_package_list(output):
    packages = set()
    for line in safe_text(output).splitlines():
        matches = re.findall(r"(?:package:)?(?:[^=\s]+\.apk=)?(com\.[A-Za-z0-9._]+|org\.[A-Za-z0-9._]+|io\.[A-Za-z0-9._]+|net\.[A-Za-z0-9._]+)", line)
        packages.update(matches)
    return packages


def scan_android_special_access_adb(rules):
    """Revisa accesibilidad, overlay, instalación de APK, VPN, perfiles y restos de paquetes."""
    status = {"available": False, "accessibility": [], "notification_listeners": [], "overlay_allowed": [], "install_packages_allowed": [], "removed_suspicious_packages": [], "profiles": [], "result": "NO_EJECUTADO"}
    if not adb_available() or not get_adb_connected_devices():
