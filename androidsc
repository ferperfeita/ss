def path_status(path):
    try:
        if os.path.exists(path):
            return "exists"
    except Exception:
        return "inaccessible_or_unknown"
    return "not_found"


def scan_integrity_indicators(rules):
    """Root/KSU/Magisk/APatch/Zygisk e integridad visible. No ejecuta su ni modifica nada."""
    findings = []

    for path in rules.get("root_paths", []):
        status = path_status(path)
        if status == "exists":
            points = 22 if any(x in path.lower() for x in ["magisk", "ksu", "apatch", "zygisk", "modules"]) else 16
            findings.append({
                "type": "integrity",
                "risk": risk_from_points(points),
                "risk_points": points,
                "confidence": confidence_from_points(points),
                "evidence_level": evidence_level(risk_from_points(points), recent=False),
                "category": "root_integridad",
                "indicator": "root_path_present",
                "value": path,
                "reasons": ["Ruta o binario asociado a root/modulos detectado"],
            })

    # which su no ejecuta privilegios; solo indica si hay binario accesible en PATH.
    su_path = run_command(["sh", "-c", "command -v su 2>/dev/null || which su 2>/dev/null"], timeout=4)
    if su_path:
        points = 18
        findings.append({
            "type": "integrity",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": confidence_from_points(points),
            "evidence_level": "moderado",
            "category": "root_integridad",
            "indicator": "su_binary_in_path",
            "value": su_path,
            "reasons": ["Binario su visible en PATH. No se intento obtener root."],
        })

    props = {
        "ro.debuggable": run_command(["getprop", "ro.debuggable"], timeout=4),
        "ro.secure": run_command(["getprop", "ro.secure"], timeout=4),
        "ro.boot.vbmeta.device_state": run_command(["getprop", "ro.boot.vbmeta.device_state"], timeout=4),
        "ro.boot.verifiedbootstate": run_command(["getprop", "ro.boot.verifiedbootstate"], timeout=4),
        "ro.boot.flash.locked": run_command(["getprop", "ro.boot.flash.locked"], timeout=4),
        "init.svc.magisk": run_command(["getprop", "init.svc.magisk"], timeout=4),
        "init.svc.zygisk": run_command(["getprop", "init.svc.zygisk"], timeout=4),
        "init.svc.ksud": run_command(["getprop", "init.svc.ksud"], timeout=4),
    }
    suspicious_props = []
    if props.get("ro.debuggable") == "1":
        suspicious_props.append("ro.debuggable=1")
    if props.get("ro.secure") and props.get("ro.secure") != "1":
        suspicious_props.append(f"ro.secure={props.get('ro.secure')}")
    if props.get("ro.boot.vbmeta.device_state") in ["unlocked"]:
        suspicious_props.append(f"vbmeta={props.get('ro.boot.vbmeta.device_state')}")
    if props.get("ro.boot.verifiedbootstate") in ["orange", "yellow", "red"]:
        suspicious_props.append(f"verifiedboot={props.get('ro.boot.verifiedbootstate')}")
    if props.get("ro.boot.flash.locked") == "0":
        suspicious_props.append("flash.locked=0")
    for key in ["init.svc.magisk", "init.svc.zygisk", "init.svc.ksud"]:
        if props.get(key) and props.get(key) not in ["", "stopped", "null"]:
            suspicious_props.append(f"{key}={props.get(key)}")
    if suspicious_props:
        points = 14 + min(10, len(suspicious_props) * 2)
        findings.append({
            "type": "integrity",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": confidence_from_points(points),
            "evidence_level": "moderado",
            "category": "root_integridad",
            "indicator": "android_integrity_props",
            "value": suspicious_props,
            "reasons": ["Propiedades de Android asociadas a bootloader/root/debug detectadas"],
        })

    # Paquetes de root visibles, incluso si no son de usuario.
    all_packages = get_all_packages()
    root_pkg_hits = []
    for pkg in all_packages:
        hits = contains_any(pkg.lower(), rules.get("package_root_indicators", []))
        if hits:
            root_pkg_hits.append({"package": pkg, "hits": sorted(set(hits))})
    if root_pkg_hits:
        points = 18
        findings.append({
            "type": "integrity",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": confidence_from_points(points),
            "evidence_level": "moderado",
            "category": "root_integridad",
            "indicator": "root_related_packages",
            "value": root_pkg_hits[:30],
            "reasons": ["Paquetes visibles relacionados con root/KSU/Magisk/APatch/Zygisk"],
        })

    return findings


def scan_hooking_indicators(rules):
    findings = []
    all_packages = get_all_packages()
    package_hits = []
    for pkg in all_packages:
        hits = contains_any(pkg.lower(), rules.get("package_hook_indicators", []))
        if hits:
