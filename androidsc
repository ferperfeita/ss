        "hooking_findings": sum(1 for x in actionable_findings if x.get("category") == "hooking_inyeccion"),
        "adb_findings": sum(1 for x in actionable_findings if x.get("category") in ["adb_depuración", "adb_avanzado", "adb_remoto_expuesto"]),
        "adb_advanced_findings": len([x for x in adb_advanced_findings if x.get("risk") != "NINGUNO"]),
        "game_file_findings": sum(1 for x in actionable_findings if x.get("category") == "archivos_juego"),
        "external_tool_findings": sum(1 for x in actionable_findings if x.get("category") == "herramientas_externas"),
        "recent_app_changes": sum(1 for x in actionable_findings if x.get("type") == "app_change"),
        "recent_app_installs": sum(1 for x in actionable_findings if x.get("type") == "app_change" and x.get("recent_install")),
        "recent_app_updates": sum(1 for x in actionable_findings if x.get("type") == "app_change" and x.get("recent_update")),
