def installer_trust_level(installer, rules):
    installer = safe_text(installer)
    if not installer:
        return "desconocido"
    if installer in rules.get("trusted_installers", []):
        return "confiable_o_sistema"
    if "packageinstaller" in installer.lower():
        return "instalador_manual_sistema"
    return "tercero"


def scan_recent_app_changes(cutoff_time, rules):
    """Lista apps instaladas o actualizadas en la ventana post-partida, aunque el nombre no sea sospechoso."""
    findings = []
    packages = get_installed_packages()

    critical_terms = rules.get("package_critical_indicators", [])
    medium_terms = rules.get("package_medium_indicators", [])
    network_terms = rules.get("package_network_indicators", [])

    for package in packages:
        details = get_package_details(package)
        first_dt = parse_android_time(details.get("first_install_time"))
        update_dt = parse_android_time(details.get("last_update_time"))
        recent_install = bool(first_dt and first_dt >= cutoff_time)
        recent_update = bool(update_dt and update_dt >= cutoff_time)

        if not recent_install and not recent_update:
            continue

        reasons = []
        points = [0]
        keyword_hits = []
        lower = package.lower()
        installer = safe_text(details.get("installer"))
        trust = installer_trust_level(installer, rules)

        if recent_install:
            add_reason(reasons, points, "App instalada dentro de la ventana post-partida", 8)
        if recent_update:
            add_reason(reasons, points, "App actualizada dentro de la ventana post-partida", 5)

        for hit in contains_any(lower, critical_terms):
            keyword_hits.append(hit)
            add_reason(reasons, points, f"Nombre de app con indicador critico: {hit}", 12)
        for hit in contains_any(lower, network_terms):
            keyword_hits.append(hit)
            add_reason(reasons, points, f"Nombre de app relacionado a proxy/VPN/tunel: {hit}", 9)
        for hit in contains_any(lower, medium_terms):
            keyword_hits.append(hit)
            add_reason(reasons, points, f"Nombre de app con indicador sensible: {hit}", 4)

        if trust == "desconocido":
            add_reason(reasons, points, "Instalador no visible o desconocido", 3)
        elif trust == "instalador_manual_sistema":
            add_reason(reasons, points, "Instalada/actualizada mediante instalador manual del sistema", 4)
        elif trust == "tercero":
            add_reason(reasons, points, f"Instalador de tercero: {installer}", 2)
        else:
            reasons.append("Instalador aparentemente confiable/sistema; puede ser actualizacion automatica")

        change_type = "install_update" if recent_install and recent_update else "install" if recent_install else "update"
        risk = risk_from_points(max(points[0], 1))
        category = category_from_text(package, reasons)
        if category == "general":
            category = "apps_recientes"

        findings.append({
            "type": "app_change",
            "risk": risk,
            "risk_points": max(points[0], 1),
            "confidence": confidence_from_points(max(points[0], 1)),
            "evidence_level": evidence_level(risk, recent=True, network=(category == "red_proxy_vpn")),
            "category": category,
            "package": package,
            "version_name": details.get("version_name"),
            "installer": installer or None,
            "installer_trust": trust,
            "code_path": details.get("code_path"),
            "first_install_time": details.get("first_install_time"),
            "last_update_time": details.get("last_update_time"),
            "recent_install": recent_install,
            "recent_update": recent_update,
            "change_type": change_type,
            "keyword_hits": sorted(set(keyword_hits)),
            "reasons": reasons,
        })

    return findings


def read_setting(scope, key):
