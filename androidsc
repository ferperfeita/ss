def _html_value(value):
    if isinstance(value, (dict, list, tuple)):
        return html.escape(json.dumps(value, ensure_ascii=False, indent=2))
    if value is None:
        return "N/A"
    return html.escape(str(value))


def _html_mapping(mapping):
    if not isinstance(mapping, dict) or not mapping:
        return '<p class="muted">Sin datos disponibles.</p>'
    rows = []
    for key, value in mapping.items():
        rows.append(
            '<div class="kv-row"><div class="kv-key">{}</div><div class="kv-value"><pre>{}</pre></div></div>'.format(
                html.escape(str(key).replace('_', ' ').title()), _html_value(value)
            )
        )
    return ''.join(rows)


def _finding_details(item):
    ignored = {
        'risk', 'risk_points', 'type', 'category', 'confidence',
        'evidence_level', 'reasons'
    }
    rows = []
    for key, value in item.items():
        if key in ignored or value in [None, '', [], {}]:
            continue
        rows.append(
            '<div class="finding-field"><span>{}</span><pre>{}</pre></div>'.format(
                html.escape(str(key).replace('_', ' ').title()), _html_value(value)
            )
        )
    return ''.join(rows)


