def verdict(summary):
    # La red aislada nunca produce revisión urgente.
    if summary.get("confirmed_integrity", 0) > 0:
        return "REVISION_URGENTE"
    if summary.get("correlated_critical_high", 0) > 0:
        return "REVISION_URGENTE"
    if summary.get("critical_risk", 0) > 0 or summary.get("correlated_findings", 0) > 0:
        return "REVISION_MANUAL"
    if summary.get("high_risk", 0) > 0 or summary.get("medium_risk", 0) > 0:
        return "OBSERVAR"
    if summary.get("low_risk", 0) > 0:
        return "OBSERVAR_BAJO"
    return "SIN_INDICADORES"


