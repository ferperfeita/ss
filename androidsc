def _normalized_snapshot_lines(text):
    """Normaliza texto genérico para comparaciones estables."""
    lines = set()
    for raw in safe_text(text).splitlines():
        line = re.sub(r"\s+", " ", raw.strip())
        if line:
            lines.add(line)
    return lines


def _normalize_logcat_line(raw):
    line = re.sub(r"\s+", " ", safe_text(raw).strip())
    if not line:
        return ""
    # Elimina fecha/epoch y PID/TID variables sin borrar tag ni mensaje.
    line = re.sub(r"^\d{10}(?:\.\d+)?\s+", "", line)
    line = re.sub(r"^\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}\.\d+\s+", "", line)
    line = re.sub(r"^\d+\s+\d+\s+[VDIWEF]\s+", "", line)
    line = re.sub(r"\b0x[0-9a-fA-F]+\b", "0xHEX", line)
    line = re.sub(r"\b(pid|tid|uid)[=: ]+\d+\b", r"\1=N", line, flags=re.I)
    return line.lower()


def _logcat_snapshot(text):
    result = {}
    for raw in safe_text(text).splitlines():
        key = _normalize_logcat_line(raw)
        if key:
            result.setdefault(key, raw.strip())
    return result


def _normalize_process_identity(raw):
    line = re.sub(r"\s+", " ", safe_text(raw).strip())
    if not line or re.search(r"\bPID\b", line, re.I):
        return ""
    parts = line.split()
    # ps -A -o USER,PID,PPID,NAME,ARGS
    if len(parts) >= 5 and parts[1].isdigit() and parts[2].isdigit():
        name = parts[3]
        args = " ".join(parts[4:])
    else:
        # Fallback toybox: el nombre suele estar al final.
        name = parts[-1] if parts else ""
        args = name
    identity = f"{name} {args}".lower()
    identity = re.sub(r"\b0x[0-9a-f]+\b", "0xHEX", identity)
    identity = re.sub(r"\b\d{4,}\b", "N", identity)
    return re.sub(r"\s+", " ", identity).strip()


def _process_snapshot(text):
    result = {}
    for raw in safe_text(text).splitlines():
        key = _normalize_process_identity(raw)
        if key:
            result.setdefault(key, raw.strip())
    return result


def _parse_socket_record(raw):
    line = re.sub(r"\s+", " ", safe_text(raw).strip())
    if not line or line.lower().startswith(("netid ", "proto ", "active ")):
        return None
    lower = line.lower()
    proto_match = re.match(r"^(tcp6?|udp6?)\b", lower)
    proto = proto_match.group(1) if proto_match else "socket"
    state = "LISTEN" if " listen " in f" {line.upper()} " else "CONNECTED"
    endpoints = re.findall(r"(?:\[?[0-9a-fA-F:.%]+\]?):(\d{1,5})", line)
    ports = []
    for value in endpoints:
        try:
            port = int(value)
            if 0 < port <= 65535:
                ports.append(port)
        except Exception:
            pass
    process_match = re.search(r'users:\(\("([^\"]+)', line)
    process = process_match.group(1) if process_match else ""
    # Para listeners el primer puerto es local; si no hay estado, conservamos todos.
    local_port = ports[0] if ports else None
    key = f"{proto}|{state}|{local_port}|{process.lower()}|{re.sub(r'pid=\d+', 'pid=N', lower)}"
    key = re.sub(r"\b\d{4,}\b", "N", key)
    return {"key": key, "line": line, "proto": proto, "state": state, "local_port": local_port, "process": process}


def _socket_snapshot(text):
    result = {}
    for raw in safe_text(text).splitlines():
        record = _parse_socket_record(raw)
        if record:
            result.setdefault(record["key"], record)
    return result


def _socket_is_public(line):
    lower = safe_text(line).lower()
    return any(token in lower for token in ["0.0.0.0:", "[::]:", ":::" ])


def capture_adb_live_baseline():
    """Captura estado inicial estable sin limpiar logcat ni modificar el dispositivo."""
    if not adb_available() or not get_adb_connected_devices():
        return {}
    epoch_text = adb_shell("date +%s", timeout=6).strip()
    try:
        device_epoch = int(epoch_text)
    except Exception:
        device_epoch = int(time.time())
    log_text = adb_shell("logcat -d -v epoch -t 5000", timeout=40)
    process_text = adb_shell("ps -A -o USER,PID,PPID,NAME,ARGS 2>/dev/null || ps -A", timeout=18)
    socket_text = adb_shell("ss -lntup 2>/dev/null || toybox netstat -lntup 2>/dev/null || netstat -lntup 2>/dev/null", timeout=18)
    return {
        "captured_at": datetime.now().isoformat(),
        "device_epoch": device_epoch,
        "logcat": _logcat_snapshot(log_text),
        "processes": _process_snapshot(process_text),
        "sockets": _socket_snapshot(socket_text),
    }


def scan_adb_live_delta(rules, baseline):
    """Detecta eventos, procesos y puertos que aparecieron durante el escaneo."""
    summary = {
        "baseline_captured": bool(baseline),
        "captured_at": baseline.get("captured_at") if baseline else None,
        "new_log_events": 0,
        "suspicious_log_events": 0,
        "new_processes": 0,
        "suspicious_new_processes": 0,
        "new_sockets": 0,
        "suspicious_new_ports": 0,
        "new_process_samples": [],
        "new_port_samples": [],
    }
    if not baseline or not get_adb_connected_devices():
        return [], summary

    epoch = baseline.get("device_epoch")
    log_text = ""
    if epoch:
        log_text = adb_shell(f"logcat -d -v epoch -T {int(epoch)}.000", timeout=40)
        if "invalid option" in log_text.lower() or "usage:" in log_text.lower():
            log_text = ""
    if log_text:
        new_log_map = _logcat_snapshot(log_text)
    else:
        after_log = _logcat_snapshot(adb_shell("logcat -d -v epoch -t 5000", timeout=40))
        new_log_map = {k: v for k, v in after_log.items() if k not in baseline.get("logcat", {})}

    after_processes = _process_snapshot(adb_shell("ps -A -o USER,PID,PPID,NAME,ARGS 2>/dev/null || ps -A", timeout=18))
    new_process_map = {k: v for k, v in after_processes.items() if k not in baseline.get("processes", {})}
    after_sockets = _socket_snapshot(adb_shell("ss -lntup 2>/dev/null || toybox netstat -lntup 2>/dev/null || netstat -lntup 2>/dev/null", timeout=18))
    new_socket_map = {k: v for k, v in after_sockets.items() if k not in baseline.get("sockets", {})}

    summary["new_log_events"] = len(new_log_map)
    summary["new_processes"] = len(new_process_map)
    summary["new_sockets"] = len(new_socket_map)
    summary["new_process_samples"] = list(new_process_map.values())[:12]

    findings = []
