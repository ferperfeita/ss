def _canonical_path(path):
    """Normaliza rutas y resuelve enlaces de /sdcard y ~/storage cuando sea posible."""
    try:
        return os.path.normcase(os.path.realpath(os.path.abspath(os.path.expanduser(path))))
    except Exception:
        return os.path.normcase(os.path.abspath(os.path.expanduser(str(path))))


def _path_is_inside(path, directory):
    try:
        path_norm = _canonical_path(path)
        directory_norm = _canonical_path(directory)
        return os.path.commonpath([path_norm, directory_norm]) == directory_norm
    except Exception:
        return False


def is_scanner_generated_path(path):
    """Evita que reportes y artefactos creados por este scanner aparezcan como hallazgos."""
    if not path:
        return False

    for output_dir in (LOCAL_REPORT_DIR, DOWNLOAD_REPORT_DIR):
        if _path_is_inside(path, output_dir):
            return True

    # Respaldo para dispositivos donde /sdcard y ~/storage resuelven de forma distinta.
    parts = {part.lower() for part in Path(str(path)).parts}
    if "andreznss_reports" in parts:
        return True

    return False

