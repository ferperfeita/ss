    if use_adb:
        step += 1
        print_scan_progress(step, total_steps, "Ejecutando revisión avanzada por ADB...", done=False)
        adb_advanced_findings = scan_adb_advanced_indicators(rules, cutoff_time)
        print_scan_progress(step, total_steps, "Revisión avanzada ADB terminada.", done=True)

        step += 1
        print_scan_progress(step, total_steps, "Verificando TermuxService, ADB inalámbrico y servidor ADB...", done=False)
