            continue
        if contains_any(key, benign_terms) and not any(term in key for term in strong_terms):
            continue
        suspicious_log.append({"event": raw[:500], "hits": hits[:8]})
    if suspicious_log:
        joined = " ".join(x["event"].lower() for x in suspicious_log)
        points = 20 if any(x in joined for x in strong_terms) else 10
        findings.append({
            "type": "live_event", "risk": risk_from_points(points), "risk_points": points,
            "confidence": "ALTA" if points >= 15 else "MEDIA", "evidence_level": "evento_nuevo_durante_scan",
            "category": "eventos_logcat_delta", "indicator": "new_suspicious_logcat_events",
            "value": suspicious_log[:20],
            "reasons": ["Logcat registró eventos sensibles después de iniciar el escaneo."],
            "source_group": "logcat"
        })
    summary["suspicious_log_events"] = len(suspicious_log)

    suspicious_processes = []
    process_terms = rules.get("suspicious_process_keywords", [])
    for key, raw in new_process_map.items():
        hits = sorted(set(contains_any(key, process_terms)))
        if hits:
            suspicious_processes.append({"process": raw[:420], "hits": hits[:8]})
    if suspicious_processes:
        points = 22
        findings.append({
            "type": "process_delta", "risk": risk_from_points(points), "risk_points": points,
            "confidence": "ALTA", "evidence_level": "proceso_nuevo_durante_scan",
            "category": "procesos_delta", "indicator": "new_suspicious_process_during_scan",
            "value": suspicious_processes[:20],
            "reasons": ["Apareció un proceso nuevo con nombre o argumentos sensibles durante el escaneo."],
            "source_group": "process"
        })
    summary["suspicious_new_processes"] = len(suspicious_processes)

    suspicious_ports = {int(x) for x in rules.get("suspicious_remote_ports", [])}
    profiles = {int(k): v for k, v in rules.get("suspicious_port_profiles", {}).items() if str(k).isdigit()}
    port_hits = []
    contextual = []
    for record in new_socket_map.values():
        port = record.get("local_port")
        if not port or port not in suspicious_ports:
            continue
        line = record.get("line", "")
        item = {"port": port, "profile": profiles.get(port, "Puerto sensible"), "process": record.get("process") or "N/D", "line": line[:360]}
        if port in (5037, 5555) and not _socket_is_public(line):
            contextual.append(item)
        else:
            port_hits.append(item)
    summary["new_port_samples"] = port_hits[:12]
    summary["contextual_adb_ports"] = len(contextual)
    if port_hits:
        strong = {23946, 23947, 27042, 27043, 31337}
        points = 21 if any(x["port"] in strong for x in port_hits) else 11
        findings.append({
            "type": "network", "risk": risk_from_points(points), "risk_points": points,
            "confidence": "ALTA" if points >= 15 else "MEDIA", "evidence_level": "puerto_nuevo_durante_scan",
            "category": "puertos_delta", "indicator": "new_suspicious_listening_port",
            "value": port_hits[:20],
            "reasons": ["Se abrió un puerto sensible después de iniciar el escaneo."],
            "source_group": "port"
        })
    summary["suspicious_new_ports"] = len(port_hits)
    return findings, summary


def scan_adb_remote_connection_indicators(rules):
    """Muestra el estado Termux/ADB diferenciando contexto esperado de exposición real."""
    status = {
        "available": False,
        "termux_service_active": False,
        "wireless_adb_active": False,
        "termux_adb_server_active": False,
        "adb_publicly_exposed": False,
        "manual_activation_log_evidence": False,
        "details": {},
    }
    if not adb_available() or not get_adb_connected_devices():
        return [], status

    status["available"] = True
    processes = adb_shell("ps -A -o USER,PID,PPID,NAME,ARGS 2>/dev/null || ps -A", timeout=18)
    services = adb_shell("dumpsys activity services com.termux 2>/dev/null | head -n 500", timeout=22)
    sockets = adb_shell("ss -lntup 2>/dev/null || toybox netstat -lntup 2>/dev/null || netstat -lntup 2>/dev/null", timeout=18)
    recent_log = adb_shell("logcat -d -v threadtime -t 1800", timeout=30)

    settings = {
        "adb_enabled": adb_shell("settings get global adb_enabled", timeout=8),
        "adb_wifi_enabled": adb_shell("settings get global adb_wifi_enabled", timeout=8),
        "adb_tcp_port": adb_shell("settings get global adb_tcp_port", timeout=8),
        "service.adb.tcp.port": adb_shell("getprop service.adb.tcp.port", timeout=8),
        "persist.adb.tcp.port": adb_shell("getprop persist.adb.tcp.port", timeout=8),
        "init.svc.adbd": adb_shell("getprop init.svc.adbd", timeout=8),
    }
    status["details"]["settings"] = settings

    combined_termux = f"{processes}\n{services}".lower()
    status["termux_service_active"] = "com.termux" in combined_termux and any(
        x in combined_termux for x in ["termuxservice", "runcommandservice", "terminalservice", "com.termux"]
    )

    tcp_values = [settings.get("adb_tcp_port"), settings.get("service.adb.tcp.port"), settings.get("persist.adb.tcp.port")]
    tcp_active = any(safe_text(v) not in ["", "0", "-1", "null", "undefined"] for v in tcp_values)
    status["wireless_adb_active"] = settings.get("adb_wifi_enabled") == "1" or tcp_active

    process_lines = []
    for line in processes.splitlines():
        lower = line.lower()
        if re.search(r"(^|\s)adb(\s|$)", lower) and "adbd" not in lower:
            process_lines.append(line.strip()[:420])
    socket_5037 = [line.strip()[:420] for line in sockets.splitlines() if re.search(r":5037(?:\s|$)", line)]
    status["termux_adb_server_active"] = bool(process_lines or socket_5037)
    status["details"]["adb_processes"] = process_lines[:12]
    status["details"]["adb_5037_sockets"] = socket_5037[:12]

    public_lines = []
    for line in sockets.splitlines():
        if re.search(r":(5037|5555)(?:\s|$)", line) and _socket_is_public(line):
            public_lines.append(line.strip()[:420])
    status["adb_publicly_exposed"] = bool(public_lines)
    status["details"]["public_adb_sockets"] = public_lines[:12]

    manual_markers = []
    for line in recent_log.splitlines():
        lower = line.lower()
        if any(x in lower for x in ["wirelessdebuggingfragment", "adb_wifi_enabled", "wireless debugging enabled", "enable wireless debugging"]):
