def load_rules():
    ensure_dirs()
    if not os.path.exists(RULES_PATH):
        with open(RULES_PATH, "w", encoding="utf-8") as f:
            json.dump(DEFAULT_RULES, f, indent=2, ensure_ascii=False)
        return DEFAULT_RULES
    try:
        with open(RULES_PATH, "r", encoding="utf-8") as f:
            user_rules = json.load(f)
        merged = dict(DEFAULT_RULES)
        for key, value in user_rules.items():
            merged[key] = value
        return merged
    except Exception:
        return DEFAULT_RULES



def load_cloud_config():
    config = dict(DEFAULT_CLOUD_CONFIG)
    try:
        if os.path.exists(CLOUD_CONFIG_PATH):
            with open(CLOUD_CONFIG_PATH, "r", encoding="utf-8") as f:
                saved = json.load(f)
            if isinstance(saved, dict):
                config.update(saved)
    except Exception:
        pass

    env_api = safe_text(os.environ.get("ANDREZNSS_REPORT_API"))
    env_token = safe_text(os.environ.get("ANDREZNSS_REPORT_TOKEN"))
    env_base = safe_text(os.environ.get("ANDREZNSS_REPORT_BASE_URL"))
    if env_api:
        config["api_url"] = env_api
        config["enabled"] = True
    if env_token:
        config["token"] = env_token
    if env_base:
        config["public_base_url"] = env_base
    config["privacy"] = "full" if safe_text(config.get("privacy")).lower() == "full" else "redacted"
    try:
        config["timeout"] = max(5, min(60, int(config.get("timeout", 25))))
    except Exception:
        config["timeout"] = 25
    return config


def save_cloud_config(config):
    ensure_dirs()
    os.makedirs(os.path.dirname(CLOUD_CONFIG_PATH), exist_ok=True)
    safe_config = dict(DEFAULT_CLOUD_CONFIG)
    safe_config.update(config or {})
    with open(CLOUD_CONFIG_PATH, "w", encoding="utf-8") as f:
        json.dump(safe_config, f, indent=2, ensure_ascii=False)
