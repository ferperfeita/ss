            "reasons": ["Se detectaron archivos OBB sin una anomalía material con estas reglas."],
        })

    status["result"] = "CONTROLES_COMPLETADOS"
    return findings, status


def _adb_sha256(path):
    output = adb_shell(f"sha256sum {shlex.quote(path)} 2>/dev/null || toybox sha256sum {shlex.quote(path)} 2>/dev/null", timeout=45)
    match = re.search(r"\b([0-9a-fA-F]{64})\b", output)
    return match.group(1).lower() if match else None


def _extract_package_signature_info(dump):
    version_code = None
    version_name = None
    installer = None
    cert_tokens = []
    for raw in safe_text(dump).splitlines():
        line = raw.strip()
        if version_code is None:
            m = re.search(r"versionCode=(\d+)", line)
            if m:
                version_code = m.group(1)
        if version_name is None and line.startswith("versionName="):
            version_name = line.split("=", 1)[1].strip()
        if installer is None and "installerPackageName=" in line:
            installer = line.split("installerPackageName=", 1)[1].split()[0].strip()
        if any(tag in line.lower() for tag in ["signatures=", "past signing certificates", "signingdetails", "certificate"]):
            cert_tokens.append(line[:500])
    cert_digest = hashlib.sha256("\n".join(cert_tokens).encode("utf-8", errors="ignore")).hexdigest() if cert_tokens else None
    return {"version_code": version_code, "version_name": version_name, "installer": installer, "certificate_evidence_digest": cert_digest, "certificate_lines": cert_tokens[:12]}


def scan_free_fire_forensics_adb(rules, cutoff_time):
    """Inventaría APK/splits y revisa exclusivamente rutas oficiales de FF normal y MAX."""
    status = {"available": False, "packages": {}, "roots_checked": 0, "recent_files": 0, "suspicious_files": 0, "result": "NO_EJECUTADO"}
    if not adb_available() or not get_adb_connected_devices():
        return [], status
    status["available"] = True
    findings = []
    now = datetime.now()
    minutes = max(1, int((now - cutoff_time).total_seconds() // 60) + 2)
    suspicious_terms = rules.get("free_fire_suspicious_path_terms", [])
    official_hashes = rules.get("official_apk_hashes", {})
    official_certs = rules.get("official_certificate_digests", {})

    for package in rules.get("free_fire_packages", []):
        if not re.fullmatch(r"[A-Za-z0-9._]+", safe_text(package)):
            continue
        pm_out = adb_shell(f"pm path {shlex.quote(package)}", timeout=10)
        apk_paths = [line.split("package:", 1)[1].strip() for line in pm_out.splitlines() if line.startswith("package:")]
        if not apk_paths:
            continue
        dump = adb_shell(f"dumpsys package {shlex.quote(package)}", timeout=25)
        signature = _extract_package_signature_info(dump)
        apk_inventory = []
        for apk_path in apk_paths[:20]:
            apk_inventory.append({"path": apk_path, "sha256": _adb_sha256(apk_path)})
        package_status = {"apk_count": len(apk_paths), "apks": apk_inventory, **signature, "roots": []}
        status["packages"][package] = package_status

        manifest = official_hashes.get(package, {}) if isinstance(official_hashes, dict) else {}
        expected_hashes = manifest.get(signature.get("version_code"), []) if isinstance(manifest, dict) else []
        if expected_hashes:
            actual = {x.get("sha256") for x in apk_inventory if x.get("sha256")}
            expected = {safe_text(x).lower() for x in expected_hashes}
            if not actual.issubset(expected):
                points = 28
                findings.append({
                    "type": "apk_integrity", "risk": risk_from_points(points), "risk_points": points,
                    "confidence": "MUY_ALTA", "evidence_level": "hash_apk_no_coincide",
                    "category": "integridad_apk_free_fire", "indicator": "free_fire_apk_hash_mismatch",
                    "package": package, "value": {"version_code": signature.get("version_code"), "actual": apk_inventory, "expected": list(expected)[:20]},
                    "reasons": ["El hash de uno o más APK/splits no coincide con el manifiesto oficial configurado."],
                    "source_group": "apk"
                })

        expected_cert = official_certs.get(package) if isinstance(official_certs, dict) else None
        if expected_cert and signature.get("certificate_evidence_digest") and signature["certificate_evidence_digest"].lower() != safe_text(expected_cert).lower():
            points = 28
            findings.append({
                "type": "apk_integrity", "risk": risk_from_points(points), "risk_points": points,
                "confidence": "MUY_ALTA", "evidence_level": "firma_paquete_no_coincide",
                "category": "integridad_apk_free_fire", "indicator": "free_fire_certificate_mismatch",
                "package": package, "value": signature,
                "reasons": ["La evidencia de firma del paquete no coincide con el digest oficial configurado."],
                "source_group": "apk"
            })

        roots = [template.format(package=package) for template in rules.get("free_fire_route_templates", [])]
        roots = sorted(set(x.replace("/storage/emulated/0", "/sdcard") for x in roots))
        for root in roots:
            exists = adb_shell(f"test -e {shlex.quote(root)} && echo EXISTS", timeout=6)
            if "EXISTS" not in exists:
                continue
            status["roots_checked"] += 1
            recent_out = adb_shell(
                f"find {shlex.quote(root)} -maxdepth 10 -type f -mmin -{minutes} -print 2>/dev/null | head -n 350",
                timeout=40,
            )
            recent_paths = [x.strip() for x in recent_out.splitlines() if x.strip()]
            package_status["roots"].append({"root": root, "recent_count": len(recent_paths)})
            status["recent_files"] += len(recent_paths)
            suspicious = []
            for path in recent_paths:
                lower = path.lower()
                hits = sorted(set(contains_any(lower, suspicious_terms)))
                ext = os.path.splitext(lower)[1]
                unexpected_obb = "/android/obb/" in lower and ext not in (".obb", "")
                if hits or unexpected_obb:
                    stat_line = adb_shell(f"stat -c '%n|%s|%Y|%a' {shlex.quote(path)} 2>/dev/null", timeout=8).strip()
                    suspicious.append({"path": path, "hits": hits, "unexpected_obb_file": unexpected_obb, "stat": stat_line[:500]})
            if suspicious:
                status["suspicious_files"] += len(suspicious)
                points = min(26, 10 + len(suspicious) * 2)
                findings.append({
                    "type": "game_file", "risk": risk_from_points(points), "risk_points": points,
                    "confidence": "ALTA" if points >= 15 else "MEDIA", "evidence_level": "archivo_reciente_en_ruta_ff",
                    "category": "archivos_free_fire", "indicator": "recent_suspicious_file_in_official_ff_path",
                    "package": package, "value": suspicious[:25],
                    "reasons": ["Se detectaron archivos recientes con nombres o extensiones sensibles dentro de rutas oficiales de Free Fire."],
                    "source_group": "game_file"
                })

        # Inventario útil, pero no se muestra como hallazgo principal.
        findings.append({
            "type": "apk_inventory", "risk": "NINGUNO", "risk_points": 0, "confidence": "ALTA",
            "evidence_level": "inventario_apk", "category": "inventario_free_fire", "indicator": "free_fire_apk_inventory",
            "package": package, "value": package_status,
            "reasons": ["Inventario de APK base, splits, versión, instalador, hashes y evidencia de firma."],
            "source_group": "apk"
        })

    status["result"] = "FREE_FIRE_NO_DETECTADO" if not status["packages"] else "COMPLETADO"
    return findings, status



def _timeline_iso_from_epoch(value):
    try:
        return datetime.fromtimestamp(float(value)).isoformat(sep=" ", timespec="seconds")
    except Exception:
        return None


def collect_game_timeline_adb(rules):
    """Construye una cronología contextual del reinicio y actividad visible de Free Fire."""
    status = {
        "available": False,
        "device_time": None,
        "uptime_seconds": None,
        "boot_time_estimated": None,
        "boot_reason": None,
        "boot_completed": None,
        "packages": {},
        "log_lines_checked": 0,
        "result": "NO_EJECUTADO",
    }
    if not adb_available() or not get_adb_connected_devices():
        return status

    status["available"] = True
    device_epoch = None
    try:
        device_epoch = int(float(adb_shell("date +%s", timeout=8).strip()))
        status["device_time"] = _timeline_iso_from_epoch(device_epoch)
    except Exception:
        pass
    try:
        uptime = float(adb_shell("cat /proc/uptime 2>/dev/null | cut -d' ' -f1", timeout=8).strip())
        status["uptime_seconds"] = round(uptime, 1)
        if device_epoch is not None:
            status["boot_time_estimated"] = _timeline_iso_from_epoch(device_epoch - uptime)
    except Exception:
        pass

    status["boot_reason"] = safe_text(adb_shell("getprop ro.boot.bootreason; getprop sys.boot.reason", timeout=8)).replace("\n", " / ") or None
    status["boot_completed"] = safe_text(adb_shell("getprop sys.boot_completed", timeout=8)) or None

    log_text = adb_shell(
        "logcat -d -v epoch -b events -b main -b system 2>/dev/null | tail -n 12000",
        timeout=50,
    )
    log_lines = [line for line in safe_text(log_text).splitlines() if line.strip()]
    status["log_lines_checked"] = len(log_lines)

    package_names = {
        "com.dts.freefireth": "Free Fire",
        "com.dts.freefiremax": "Free Fire MAX",
        "com.dts.freefire": "Free Fire",
    }

    for package in rules.get("free_fire_packages", []):
        if not re.fullmatch(r"[A-Za-z0-9._]+", safe_text(package)):
            continue
        pm_path = adb_shell(f"pm path {shlex.quote(package)}", timeout=8)
        installed = any(line.startswith("package:") for line in pm_path.splitlines())
        if not installed:
            continue

        pkg_state = {
            "name": package_names.get(package, package),
            "package": package,
            "installed": True,
            "running_now": False,
            "pid": None,
            "first_install_time": None,
            "last_update_time": None,
            "last_process_start": None,
            "last_foreground_event": None,
            "last_event": None,
            "visible_log_events": 0,
        }

        times = _package_install_update_times_adb(package)
        if isinstance(times, dict):
            first = times.get("first_install_time")
            update = times.get("last_update_time")
            pkg_state["first_install_time"] = first.isoformat(sep=" ", timespec="seconds") if isinstance(first, datetime) else safe_text(first) or None
            pkg_state["last_update_time"] = update.isoformat(sep=" ", timespec="seconds") if isinstance(update, datetime) else safe_text(update) or None

        pid = safe_text(adb_shell(f"pidof {shlex.quote(package)} 2>/dev/null", timeout=8)).split()
        if pid:
            pkg_state["running_now"] = True
            pkg_state["pid"] = pid[0]

        last_any = None
        last_proc = None
        last_fg = None
        count = 0
        for line in log_lines:
            lower = line.lower()
            if package.lower() not in lower:
                continue
            count += 1
            m = re.match(r"\s*([0-9]{9,}(?:\.[0-9]+)?)\s+", line)
            if not m:
                continue
            try:
                epoch = float(m.group(1))
            except Exception:
                continue
            stamp = _timeline_iso_from_epoch(epoch)
            if stamp:
                last_any = stamp
            if any(marker in lower for marker in ("am_proc_start", "start proc", "process_start", "proc_start")):
                last_proc = stamp or last_proc
            if any(marker in lower for marker in ("am_on_resume_called", "wm_on_resume_called", "onresume", "resumedactivity", "top resumed", "move_to_foreground")):
                last_fg = stamp or last_fg

        pkg_state["visible_log_events"] = count
        pkg_state["last_event"] = last_any
        pkg_state["last_process_start"] = last_proc
        pkg_state["last_foreground_event"] = last_fg
        status["packages"][package] = pkg_state

    status["result"] = "FREE_FIRE_NO_DETECTADO" if not status["packages"] else "COMPLETADO"
    return status


