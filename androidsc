    if package_hits:
        points = 20
        findings.append({
            "type": "hooking",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": confidence_from_points(points),
            "evidence_level": "moderado",
            "category": "hooking_inyeccion",
            "indicator": "hooking_related_packages",
            "value": package_hits[:30],
            "reasons": ["Paquetes visibles relacionados con Xposed/LSPosed/Frida/hooking"],
        })

    proc_text = ""
    if command_exists("ps"):
        proc_text = run_command(["ps", "-A"], timeout=6) or run_command(["ps"], timeout=6)
    process_hits = []
    for line in proc_text.splitlines():
        lower = line.lower()
        hits = contains_any(lower, rules.get("hook_keywords", []))
        if hits:
            process_hits.append({"line": line.strip()[:260], "hits": sorted(set(hits))})
    if process_hits:
        points = 24
        findings.append({
            "type": "hooking",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": confidence_from_points(points),
            "evidence_level": "fuerte_proceso_activo",
            "category": "hooking_inyeccion",
            "indicator": "hooking_process_visible",
            "value": process_hits[:30],
            "reasons": ["Proceso visible relacionado con hooking/inyeccion detectado"],
        })

    for path in rules.get("hook_paths", []):
        if path_status(path) == "exists":
            points = 18
            findings.append({
                "type": "hooking",
                "risk": risk_from_points(points),
                "risk_points": points,
                "confidence": confidence_from_points(points),
                "evidence_level": "moderado",
                "category": "hooking_inyeccion",
                "indicator": "hooking_path_present",
                "value": path,
                "reasons": ["Ruta/archivo asociado a Frida/Xposed/LSPosed detectado"],
            })

    return findings


