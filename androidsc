    print_scan_progress(step, total_steps, "Apps y timestamps revisados.", done=True)

    step += 1
    print_scan_progress(step, total_steps, "Recolectando datos del sistema y depuración ADB local...", done=False)
    adb_findings = scan_adb_indicators(rules)
    device_flag_findings = scan_device_security_flags()
    print_scan_progress(step, total_steps, "Datos del sistema recolectados.", done=True)

    adb_advanced_findings = []
    adb_remote_findings = []
    reference_findings = []
    replay_findings = []
    live_delta_findings = []
    ff_forensic_findings = []
    special_access_findings = []
    bugreport_findings = []
    adb_remote_status = {"available": False}
    reference_status = {"available": False, "result": "NO_EJECUTADO"}
    replay_status = {"available": False, "result": "NO_EJECUTADO"}
    ff_forensic_status = {"available": False, "result": "NO_EJECUTADO"}
    special_access_status = {"available": False, "result": "NO_EJECUTADO"}
    bugreport_status = {"available": False, "result": "NO_EJECUTADO"}
    bugreport_capture_status = {"available": False, "generated": False, "result": "NO_EJECUTADO"}
    live_delta_summary = {"baseline_captured": False}
